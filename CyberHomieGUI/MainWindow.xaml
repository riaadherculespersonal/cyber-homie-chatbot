<Window x:Class="CyberHomieGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberHomie – Digital Defender" Height="720" Width="1020"
        Background="#1a002b" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#bb33ff"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#330042"/>
        </Style>
    </Window.Resources>

    <Grid>
        <TabControl SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="💬 Chatbot">
                <Grid Background="#1a002b">
                    <StackPanel Margin="10">
                        <TextBlock Text="🤖 CyberHomie – Digital Defender"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="#cc33ff"
                                   HorizontalAlignment="Center"
                                   Margin="10"/>
                        <ScrollViewer x:Name="ChatScrollViewer" Height="400" VerticalScrollBarVisibility="Auto"
                                      Background="Black" Margin="0,5">
                            <TextBlock x:Name="ChatHistory" TextWrapping="Wrap" Margin="10"/>
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Margin="0,10">
                            <TextBox x:Name="UserInputTextBox" Height="30" Width="700"
                                     KeyDown="UserInputTextBox_KeyDown"/>
                            <Button Content="📨 Send" Width="100" Height="30"
                                    Click="SendButton_Click"/>
                            <Button Content="📜 Show Activity Log" Width="180"
                                    Click="ShowLogButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="📅 Task Assistant">
                <Grid Background="#1a002b">
                    <StackPanel Margin="10">
                        <TextBlock Text="📅 Task Assistant – Cyber Reminder"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="#cc33ff" HorizontalAlignment="Center"/>
                        <TextBlock Text="Task Title:" Margin="5,10,0,0"/>
                        <TextBox x:Name="TitleTextBox"/>
                        <TextBlock Text="Task Description:" Margin="5,10,0,0"/>
                        <TextBox x:Name="DescriptionTextBox"/>
                        <TextBlock Text="Reminder Date:" Margin="5,10,0,0"/>
                        <DatePicker x:Name="ReminderDatePicker"/>
                        <Button Content="➕ Add Task" Click="AddTaskButton_Click"/>
                        <ListView x:Name="TaskListView" Height="200" Margin="0,10,0,0" Background="#2a003f">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="200"/>
                                    <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="300"/>
                                    <GridViewColumn Header="Reminder Date" DisplayMemberBinding="{Binding ReminderDate}" Width="200"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="✔ Mark Done" Click="MarkDoneButton_Click"/>
                            <Button Content="🗑 Delete" Click="DeleteButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="🧠 Quiz">
                <Grid Background="#1a002b">
                    <StackPanel Margin="10">
                        <TextBlock Text="🧠 Cyber Quiz – Test Yo Knowledge!"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="#cc33ff" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="QuestionTextBlock" Margin="10" TextWrapping="Wrap"/>
                        <StackPanel x:Name="AnswerButtonsPanel" Margin="10"/>
                        <Button x:Name="NextQuestionButton" Content="➡ Next" Visibility="Collapsed"
                                Click="NextQuestionButton_Click"/>
                        <TextBlock x:Name="FeedbackTextBlock" FontWeight="Bold" Margin="10"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
