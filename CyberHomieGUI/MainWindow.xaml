<Window x:Class="CyberHomieGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberHomie – Digital Defender" Height="600" Width="800" Background="Black">
    <Grid>
        <TabControl>
            <!-- Chatbot Tab -->
            <TabItem Header="Chatbot">
                <Grid Background="Black" Margin="10">
                    <StackPanel>
                        <TextBlock Text="🤖 CyberHomie – Digital Defender" FontSize="24" FontWeight="Bold" Foreground="Cyan" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                        <ScrollViewer Height="350" VerticalScrollBarVisibility="Auto" Background="Black">
                            <TextBlock x:Name="ChatHistoryTextBlock" TextWrapping="Wrap" Foreground="White"/>
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBox x:Name="UserInputTextBox" Width="600" Height="30" FontSize="14"/>
                            <Button Content="Send" Width="100" Height="30" Background="Cyan" Click="SendButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Task Assistant Tab -->
            <TabItem Header="Task Assistant">
                <Grid Background="Black" Margin="10">
                    <StackPanel>
                        <TextBlock Text="📅 Task Assistant – Cyber Reminder" FontSize="24" FontWeight="Bold" Foreground="Cyan" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                        <TextBlock Text="Task Title:" Foreground="White"/>
                        <TextBox x:Name="TitleTextBox" Height="25" Margin="0,5"/>

                        <TextBlock Text="Task Description:" Foreground="White"/>
                        <TextBox x:Name="DescriptionTextBox" Height="25" Margin="0,5"/>

                        <TextBlock Text="Reminder Date:" Foreground="White"/>
                        <DatePicker x:Name="ReminderDatePicker" Height="25" Margin="0,5"/>

                        <Button Content="➕ Add Task" Click="AddTaskButton_Click" Background="Cyan" Height="30" Margin="0,10" Width="150" HorizontalAlignment="Center"/>

                        <ListView x:Name="TaskListView" Margin="0,10">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}"/>
                                    <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}"/>
                                    <GridViewColumn Header="Reminder Date" DisplayMemberBinding="{Binding ReminderDate}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                            <Button Content="✔ Mark Done" Click="MarkDoneButton_Click" Width="100" Margin="10"/>
                            <Button Content="🗑 Delete" Click="DeleteTaskButton_Click" Width="100" Margin="10"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Quiz Tab -->
            <TabItem Header="Quiz">
                <Grid Background="Black" Margin="10">
                    <StackPanel>
                        <TextBlock Text="🧠 Cybersecurity Quiz" FontSize="24" FontWeight="Bold" Foreground="Cyan" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="QuestionTextBlock" Text="Question will appear here." FontSize="16" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <StackPanel x:Name="AnswerButtonsPanel" Margin="0,0,0,10"/>
                        <Button x:Name="NextQuestionButton" Content="Next Question" Click="NextQuestionButton_Click" Background="Cyan" Margin="0,10,0,0" HorizontalAlignment="Center" Width="150"/>
                        <TextBlock x:Name="FeedbackTextBlock" FontSize="14" Foreground="LightGreen" Margin="0,10,0,0"/>
                        <TextBlock x:Name="ScoreTextBlock" FontSize="16" Foreground="Yellow" FontWeight="Bold" Margin="0,20,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
