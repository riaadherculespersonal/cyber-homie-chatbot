<Window x:Class="CyberHomieGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberHomie – Digital Defender" Height="600" Width="800"
        Background="Black">
    <TabControl>
        <!-- Chatbot Tab -->
        <TabItem Header="Chatbot">
            <Grid Background="Black">
                <StackPanel Margin="20">
                    <TextBlock Text="🤖 CyberHomie – Digital Defender"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="Cyan"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <ScrollViewer Height="350" VerticalScrollBarVisibility="Auto" Background="Black">
                        <TextBlock x:Name="ChatHistoryTextBlock" Foreground="White" TextWrapping="Wrap"/>
                    </ScrollViewer>

                    <DockPanel Margin="0,10,0,0">
                        <TextBox x:Name="UserInputBox" Width="600" Height="30" FontSize="14" Margin="0,0,10,0"/>
                        <Button Content="Send" Width="100" Background="Cyan" Click="SendButton_Click"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- Task Assistant Tab -->
        <TabItem Header="Task Assistant">
            <Grid Background="Black" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Title Label -->
                    <RowDefinition Height="Auto"/>
                    <!-- Title Box -->
                    <RowDefinition Height="Auto"/>
                    <!-- Description Label -->
                    <RowDefinition Height="Auto"/>
                    <!-- Description Box -->
                    <RowDefinition Height="Auto"/>
                    <!-- Date Label -->
                    <RowDefinition Height="Auto"/>
                    <!-- Date Picker -->
                    <RowDefinition Height="Auto"/>
                    <!-- Button -->
                    <RowDefinition Height="*"/>
                    <!-- Task Grid -->
                    <RowDefinition Height="Auto"/>
                    <!-- Mark/Delete Buttons -->
                </Grid.RowDefinitions>

                <TextBlock Text="Task Title:" Foreground="White" Grid.Row="0"/>
                <TextBox x:Name="TaskTitleBox" Grid.Row="1" Height="30"/>

                <TextBlock Text="Task Description:" Foreground="White" Grid.Row="2" Margin="0,10,0,0"/>
                <TextBox x:Name="TaskDescriptionBox" Grid.Row="3" Height="30"/>

                <TextBlock Text="Reminder Date:" Foreground="White" Grid.Row="4" Margin="0,10,0,0"/>
                <DatePicker x:Name="ReminderDatePicker" Grid.Row="5" Height="30"/>

                <Button Content="➕ Add Task" Grid.Row="6" Height="40" Margin="0,10,0,10"
                        Background="Cyan" Click="AddTaskButton_Click"/>

                <DataGrid x:Name="TaskDataGrid" Grid.Row="7" AutoGenerateColumns="False" Height="200"
                          HeadersVisibility="Column" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Reminder Date" Binding="{Binding ReminderDate}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" Grid.Row="8" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="✔️ Mark Done" Margin="5" Click="MarkDoneButton_Click"/>
                    <Button Content="🗑️ Delete" Margin="5" Click="DeleteTaskButton_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
