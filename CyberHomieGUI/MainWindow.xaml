<Window x:Class="CyberHomieGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberHomie – Digital Defender" Height="500" Width="600" Background="#FF1E1E1E">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="🤖 CyberHomie – Digital Defender"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="Cyan"
                   Margin="10"
                   HorizontalAlignment="Center"/>

        <!-- Chat display area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Black" Margin="0,10,0,10">
            <TextBlock x:Name="ChatHistoryTextBlock"
                       TextWrapping="Wrap"
                       FontSize="14"
                       Foreground="White"
                       Margin="10"/>
        </ScrollViewer>

        <!-- Input + Send button -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBox x:Name="UserInputTextBox" Width="450" Height="30" FontSize="14" Margin="0,0,10,0"/>
            <Button Content="Send" Width="100" Height="30" Background="Cyan" Click="SendButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
